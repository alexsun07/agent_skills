#!/bin/bash

pid=$1

if [ -z "$pid" ]; then
    echo "usage: $(basename "$0") <pid>" >&2
    exit 2
fi

# One authoritative lookup: owner, elapsed seconds, full command line.
# -p matches the PID exactly, so no substring collisions with other PIDs.
ps_line=$(ps -p "$pid" -o user:32=,etimes=,args= 2>/dev/null)

if [ -z "$ps_line" ]; then
    echo "PID $pid: N/A (no such process — it exited, or /proc is not visible from here)"
    exit 1
fi

# `read` with a trailing var soaks up the rest, so args keeps its spaces.
read -r user elapsed_seconds cmd <<< "$ps_line"

# Convert seconds to human-friendly format
days=$((elapsed_seconds / 86400))
hours=$(( (elapsed_seconds % 86400) / 3600 ))
minutes=$(( (elapsed_seconds % 3600) / 60 ))
seconds=$((elapsed_seconds % 60))

human_time=""
[ "$days" -gt 0 ] && human_time="${human_time}${days}d "
[ "$hours" -gt 0 ] && human_time="${human_time}${hours}h "
[ "$minutes" -gt 0 ] && human_time="${human_time}${minutes}m "
human_time="${human_time}${seconds}s"

echo "PID:     $pid"
echo "User:    $user"
echo "Uptime:  $human_time"
echo "Command: $cmd"

if [ "$user" != "root" ]; then
    echo "user: $user. Exiting."
    exit 0
fi

echo "------------------------------------------------------------"
echo "Process is running as root. Checking cgroup..."

# Get container ID from cgroup. The layout differs by cgroup version and runtime:
#   v2 systemd:  0::/system.slice/docker-<64hex>.scope
#   v1 cgroupfs: 11:memory:/docker/<64hex>
#   k8s:         .../kubepods/besteffort/pod<uid>/<64hex>
# The 64-hex container ID is the one constant, so pull it out directly rather
# than slicing at a fixed offset.
cgroup_info=$(cat /proc/"$pid"/cgroup 2>/dev/null)
container_id_full=$(echo "$cgroup_info" | grep -oE -m 1 '[0-9a-f]{64}' | head -n 1)
container_id=${container_id_full:0:12}

if [ -z "$container_id" ]; then
    echo "Could not find a container ID in cgroup info. Raw cgroup:"
    echo "${cgroup_info:-  (unreadable — /proc/$pid/cgroup needs elevated permissions)}"
    exit 1
fi

echo "Container ID (first 12 chars): $container_id"
echo "------------------------------------------------------------"
echo "Matching container:"
docker ps -a --filter "id=$container_id" \
    --format 'table {{.ID}}\t{{.Names}}\t{{.Image}}\t{{.Status}}' 2>&1
echo "------------------------------------------------------------"
